LoadModule proxy_module modules/mod_proxy.so
LoadModule proxy_http_module modules/mod_proxy_http.so

<VirtualHost *:80>
    # Uncomment ServerName and edit server.libki.org to your domain name.
    # If uncommented, all http calls to this server will be directed to the libki server.
    #
    #ServerName server.libki.org

    # Multi-tenant only: uncomment and set to the instance name.
    # Leave unset for a normal install, whose users and settings live in the
    # default (empty) instance. Setting it to a name that has not been created
    # with script/administration/create_instance.pl breaks login.
    #RequestHeader set libki-instance "libki"

    # If TLS is terminated here, send the public URL so Libki builds correct links:
    #RequestHeader set X-Request-Base "https://libki.server.org"

    DocumentRoot /home/libki/libki-server
    <Proxy *>
        Order deny,allow
        Allow from allow
    </Proxy>
    ProxyPass        / http://localhost:3000/ retry=0
    ProxyPassReverse / http://localhost:3000/ retry=0
</VirtualHost>
